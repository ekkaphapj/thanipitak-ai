# Server
PORT=3100
HOST=0.0.0.0

# JWT (change in production)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# For future PostgreSQL migration (SQLite is used in this sandbox phase)
DATABASE_URL=
REAL_SUPABASE_URL=
REAL_SUPABASE_ANON_KEY=
DB_PATH=./data/thanipitak-realistic.db

# Local AI (Ollama) - do NOT expose port 11434 to the Internet
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=scb10x/llama3.1-typhoon2-8b-instruct:latest
# Experimental no-tool Intent JSON Router. Keep `tools` for the native
# Typhoon2 tool-calling path; use `intent` only for local model experiments.
OLLAMA_ROUTING_MODE=tools
OLLAMA_INTENT_MODEL=hf.co/typhoon-ai/typhoon2.5-qwen3-4b-gguf:Q4_K_M

# Local speech-to-text (loopback only). Browser talks to this app, not to 8178.
STT_ENABLED=true
STT_URL=http://127.0.0.1:8178
STT_TIMEOUT_MS=30000
STT_MAX_BYTES=5242880
STT_LANGUAGE=th
STT_MODEL=Vinxscribe/biodatlab-whisper-th-medium-faster
