[Unit]
Description=ThaniPitak local STT (faster-whisper, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ekkaphap
Group=ekkaphap
WorkingDirectory=/home/ekkaphap/thanipitak-ai
# Loopback only — the app proxies authenticated audio here; never expose
# this port through Caddy or the Cloudflare Tunnel.
Environment=STT_BIND=127.0.0.1
Environment=STT_PORT=8178
Environment=STT_MODEL=Vinxscribe/biodatlab-whisper-th-medium-faster
# Phase 1 fast path (docs/stt-client-first-design.md §5): run Whisper on
# the RTX 3060, int8_float16 needs ~1.2 GB VRAM.
# VRAM policy — one system at a time, memory returns after use:
#   * STT unloads after 10 idle minutes and reloads on the next request.
#   * The app sets OLLAMA_KEEP_ALIVE=5m so Ollama frees ~6.5 GB after chat
#     goes idle (see thanipitak-ai.service).
#   * Do not run ComfyUI (~5 GB) while voice or chat is active; do not
#     load 14B-class Ollama models on this GPU.
# If CUDA/cuDNN is missing on a box, fall back with:
#   STT_DEVICE=cpu STT_COMPUTE=int8 STT_BEAM=8
Environment=STT_DEVICE=cuda
Environment=STT_COMPUTE=int8_float16
Environment=STT_BEAM=5
Environment=STT_IDLE_UNLOAD_MIN=10
# GPU decode needs cuBLAS/cuDNN, which the host lacks (Ollama keeps its
# CUDA inside Docker). Install into the venv once:
#   .venv-stt/bin/pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# Without this path the model LOADS but every real-speech decode dies with
# "libcublas.so.12 is not found" (2026-10-05 incident).
Environment=LD_LIBRARY_PATH=/home/ekkaphap/thanipitak-ai/.venv-stt/lib/python3.14/site-packages/nvidia/cublas/lib:/home/ekkaphap/thanipitak-ai/.venv-stt/lib/python3.14/site-packages/nvidia/cudnn/lib
ExecStart=/home/ekkaphap/thanipitak-ai/.venv-stt/bin/python /home/ekkaphap/thanipitak-ai/scripts/stt-server.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
KillSignal=SIGTERM
# Hardening kept from the originally installed unit.
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
