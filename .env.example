# Server
PORT=3100
HOST=0.0.0.0

# JWT (change in production)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# For future PostgreSQL migration (SQLite is used in this sandbox phase)
DATABASE_URL=
DB_PATH=./data/thanipitak.db

# Local AI (Ollama) - do NOT expose port 11434 to the Internet
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# RAG knowledge is static operational documentation. Live case/patient data
# must still be read through permission-checked tools, never copied into RAG.
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_KNOWLEDGE_DIR=./knowledge
RAG_INDEX_PATH=./data/rag-index.json
